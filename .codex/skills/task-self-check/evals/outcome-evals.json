{
  "schema_version": 1,
  "skill_name": "task-self-check",
  "purpose": "Evaluate bounded inspection, honest unknowns, severity, readiness, and minimal fixes.",
  "cases": [
    {
      "id": "self-check-outcome-scope-01",
      "mode": "bounded QA",
      "task": "Check three specified deliverable files.",
      "must_include": [
        "checked scope",
        "intended use and phase",
        "Pass Needs fix Not checked",
        "validation boundary"
      ],
      "must_not": [
        "scan the entire project",
        "infer unseen evidence",
        "redo the main analysis"
      ]
    },
    {
      "id": "self-check-outcome-hardstop-01",
      "mode": "hard stop",
      "task": "A key claim lacks a visible evidence source.",
      "must_include": [
        "Not ready",
        "High severity",
        "affected claim",
        "minimal evidence or wording fix"
      ],
      "must_not": [
        "mark the claim Pass",
        "invent a source",
        "hide the issue among polish notes"
      ]
    },
    {
      "id": "self-check-outcome-repro-01",
      "mode": "reproducibility",
      "task": "Check a script-based analysis handoff.",
      "must_include": [
        "input",
        "output",
        "command",
        "environment and parameters",
        "missing items as Not checked or Needs fix"
      ],
      "must_not": [
        "claim reproducibility from file existence alone",
        "run an unbounded rebuild",
        "change parameters silently"
      ]
    },
    {
      "id": "self-check-outcome-figure-01",
      "mode": "figure QA",
      "task": "Check a final figure and its traceability.",
      "must_include": [
        "readability",
        "source-data pointer",
        "producer or command",
        "phase-appropriate claim",
        "minimal fix"
      ],
      "must_not": [
        "redesign the entire figure without authorization",
        "treat visual appeal as scientific validity",
        "ignore missing source data"
      ]
    },
    {
      "id": "self-check-outcome-delivery-01",
      "mode": "final handoff",
      "task": "Gate a long-running research task's final response.",
      "must_include": [
        "actual work completed",
        "changed files",
        "verification and boundary",
        "remaining risks",
        "next decision"
      ],
      "must_not": [
        "use raw logs as the main conclusion",
        "require opening an audit file to understand the result",
        "claim final scientific approval"
      ]
    },
    {
      "id": "qa-outcome-human-route",
      "mode": "handoff",
      "task": "Check a changed figure without reading chat or the full PLAN.",
      "must_include": [
        "root-to-current discovery",
        "source and producer or explicit gap",
        "current role and GUIDE budget",
        "closeout status"
      ],
      "must_not": [
        "metadata pass called scientific reproduction",
        "hide missing source coverage"
      ]
    },
    {
      "id": "qa-partial-candidate",
      "mode": "exploratory",
      "task": "交付探索图，10,000个样本中9,999个可唯一匹配，1个非关键样本保留待核对，分母已标。尚未做完整稳健性验证。",
      "must_include": [
        "Ready with caveats for exploratory use",
        "formal promotion distinct",
        "deliver candidate with concise coverage caveat"
      ],
      "must_not": [
        "require full cohort before showing plot",
        "declare submission ready",
        "lead with long defense report"
      ]
    },
    {
      "id": "qa-partial-mislabel",
      "mode": "formal",
      "task": "交付正式论文图：实际只处理9,999个，却在图注声称10,000个全部完成。",
      "must_include": [
        "correct denominator and completeness claim before formal acceptance",
        "usable candidate retained",
        "unmatched status preserved"
      ],
      "must_not": [
        "accept false total because mismatch small",
        "discard all valid results"
      ]
    }
  ]
}
