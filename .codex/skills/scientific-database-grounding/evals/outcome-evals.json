{
  "schema_version": 1,
  "skill_name": "scientific-database-grounding",
  "purpose": "Evaluate entity resolution, query provenance, cross-source conflicts, credential safety, and database-evidence boundaries.",
  "cases": [
    {
      "id": "database-outcome-variant-01",
      "mode": "variant reconciliation",
      "task": "Reconcile one variant across dbSNP, ClinVar, gnomAD, and VEP.",
      "must_include": [
        "input and resolved identifiers",
        "genome build and REF/ALT",
        "transcript context",
        "source versions or access dates",
        "agreement and unresolved conflicts"
      ],
      "must_not": [
        "merge assemblies silently",
        "treat clinical significance as mechanism proof",
        "omit allele orientation"
      ]
    },
    {
      "id": "database-outcome-api-01",
      "mode": "reproducible API query",
      "task": "Retrieve a bounded record set from an official API.",
      "must_include": [
        "endpoint and exact query parameters",
        "fields and pagination",
        "count-first or small-sample check",
        "record count and access date",
        "failure or rate-limit status"
      ],
      "must_not": [
        "print credentials",
        "read an entire large response into context",
        "claim an unexecuted query succeeded"
      ]
    },
    {
      "id": "database-outcome-protein-01",
      "mode": "protein structure grounding",
      "task": "Compare experimental and predicted structure records.",
      "must_include": [
        "accession and isoform",
        "experimental versus predicted labels",
        "chain and residue numbering",
        "confidence or evidence code",
        "missing-region caveats"
      ],
      "must_not": [
        "call a predicted model experimental",
        "silently choose a canonical isoform",
        "infer binding from structure presence"
      ]
    },
    {
      "id": "database-outcome-conflict-01",
      "mode": "cross-source conflict",
      "task": "Handle contradictory database annotations.",
      "must_include": [
        "source-specific values",
        "release or date context",
        "identifier mapping checks",
        "unresolved conflict",
        "safe downstream handoff"
      ],
      "must_not": [
        "select the convenient source without reason",
        "erase release lag",
        "upgrade annotation to validation"
      ]
    },
    {
      "id": "database-outcome-empty-01",
      "mode": "empty or failed query",
      "task": "Report an empty result from a bounded database lookup.",
      "must_include": [
        "exact searched scope",
        "query and source status",
        "empty versus failed distinction",
        "alternative source or retry path",
        "no-existence boundary"
      ],
      "must_not": [
        "claim the entity does not exist",
        "fabricate a fallback record",
        "expose tokens or headers"
      ]
    },
    {
      "id": "database-outcome-backend-01",
      "mode": "execution backend selection",
      "task": "Select an execution backend for a cross-database gene and variant lookup.",
      "must_include": [
        "CAP-DB-001 registry route",
        "smallest source-specific backend set",
        "network credentials and source-term preflight",
        "backend version exact queries and record counts",
        "planned-query fallback when unavailable"
      ],
      "must_not": [
        "treat the registry as install authority",
        "default to an aggregator without comparison",
        "claim an unavailable backend was executed"
      ]
    },
    {
      "id": "db-partial-ids",
      "mode": "exploratory",
      "task": "100个蛋白ID里99个能唯一解析，1个已退役且暂时找不到替代，先给注释结果。",
      "must_include": [
        "return 99 usable records plus unresolved retired ID",
        "actual returned count and version/date",
        "continue without complete mapping"
      ],
      "must_not": [
        "invent replacement accession",
        "drop unresolved ID silently",
        "halt all retrieval"
      ]
    },
    {
      "id": "db-partial-build",
      "mode": "reconciliation",
      "task": "少数变异位点的build未知，其余build明确，另有已确认的蛋白注释结果。",
      "must_include": [
        "isolate unresolved variants",
        "deliver confirmed protein records and unaffected variants",
        "no coordinate interpretation for unknown build"
      ],
      "must_not": [
        "guess assembly",
        "halt all independent annotation"
      ]
    }
  ]
}
