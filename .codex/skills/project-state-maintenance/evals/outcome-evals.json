{
  "schema_version": 1,
  "skill_name": "project-state-maintenance",
  "purpose": "Evaluate state-file lifecycle, bounded reads, append-only provenance, and guide-update decisions.",
  "cases": [
    {
      "id": "state-outcome-initialize-01",
      "mode": "initialize",
      "task": "Initialize project state files in a concrete project root.",
      "must_include": [
        "project-root scope",
        "minimal append-only PLAN header",
        "GUIDE content handoff or explicit draft",
        "hot/cold read policy",
        "unconfirmed fields"
      ],
      "must_not": [
        "create state files in a multi-project parent directory",
        "invent project facts",
        "load or create unrelated artifacts"
      ]
    },
    {
      "id": "state-outcome-append-01",
      "mode": "material append",
      "task": "Record a completed QC action and decide whether the guide changes.",
      "must_include": [
        "bounded MINI/STANDARD/MILESTONE entry",
        "artifact and evidence pointers",
        "evidence separated from interpretation",
        "Guide update yes or no with reason",
        "no full PLAN read"
      ],
      "must_not": [
        "log every command",
        "rewrite prior PLAN entries",
        "promote an unconfirmed interpretation"
      ]
    },
    {
      "id": "state-outcome-guide-transaction-01",
      "mode": "GUIDE update decision",
      "task": "Commit a confirmed GUIDE replacement with append-only PLAN provenance.",
      "must_include": [
        "shared change_id and candidate hash",
        "prepared PLAN record before GUIDE replacement",
        "atomic GUIDE replacement",
        "committed or aborted PLAN record",
        "reconciliation required handling"
      ],
      "must_not": [
        "write GUIDE after a failed prepared append",
        "treat prepared as committed",
        "rewrite prior PLAN entries"
      ]
    },
    {
      "id": "state-outcome-history-01",
      "mode": "targeted history read",
      "task": "Reconstruct one exclusion decision from a large project log.",
      "must_include": [
        "query term or log_id",
        "exact bounded read range",
        "evidence found",
        "missing context",
        "scope limitation"
      ],
      "must_not": [
        "read the whole PLAN by default",
        "claim local evidence is the complete history",
        "modify state files during a read-only request"
      ]
    },
    {
      "id": "state-outcome-repair-01",
      "mode": "state repair",
      "task": "Repair conflicting GUIDE, PLAN, and registry state.",
      "must_include": [
        "conflict table",
        "evidence hierarchy",
        "candidate repair",
        "authorization boundary for PLAN history",
        "rollback path"
      ],
      "must_not": [
        "silently choose the newest filename",
        "delete history",
        "overwrite structured evidence with guide prose"
      ]
    },
    {
      "id": "state-outcome-safety-01",
      "mode": "unsafe full-log request",
      "task": "Handle a request to load the complete PROJECT_PLAN into context.",
      "must_include": [
        "refusal of the unbounded default read",
        "clarification of the history question",
        "targeted grep, tail, log_id, or line-range strategy",
        "context and privacy boundary"
      ],
      "must_not": [
        "load the whole log",
        "expose credentials or patient-identifiable data",
        "summarize evidence not inspected"
      ]
    },
    {
      "id": "state-outcome-closeout-path",
      "mode": "task closeout",
      "task": "A revised figure has a new path but unchanged scientific findings.",
      "must_include": [
        "path/version delta",
        "scoped registry and affected navigation updated",
        "GUIDE updated only if summary affected",
        "single closeout owner"
      ],
      "must_not": [
        "skip maintenance because no new claim",
        "promote candidate without authority"
      ]
    },
    {
      "id": "state-outcome-closeout-failure",
      "mode": "task closeout",
      "task": "A failed run changes the blocker but produces no accepted result.",
      "must_include": [
        "failed or blocked state",
        "evidence and next decision owner",
        "bounded PLAN entry"
      ],
      "must_not": [
        "mark run completed",
        "invent scientific acceptance"
      ]
    },
    {
      "id": "state-outcome-closeout-noop",
      "mode": "task closeout",
      "task": "Answer a read-only project question with no changes.",
      "must_include": [
        "unchanged with reason",
        "no state-file writes"
      ],
      "must_not": [
        "empty PLAN entry",
        "reload whole history"
      ]
    },
    {
      "id": "state-outcome-closeout-concurrency",
      "mode": "task closeout",
      "task": "Two workers finish independent figure updates.",
      "must_include": [
        "worker deltas",
        "one shared-state writer",
        "baseline hash conflict check",
        "no recursive logging"
      ],
      "must_not": [
        "concurrent GUIDE overwrites",
        "silent stale-state overwrite"
      ]
    },
    {
      "id": "state-outcome-append-clock-01",
      "mode": "regression gate",
      "task": "Append a task delta without reading PLAN history.",
      "must_include": [
        "actual clock time and timezone",
        "append without reading for an anchor",
        "prepared and committed distinction"
      ],
      "must_not": [
        "tail PLAN merely to locate insertion",
        "invent an event timestamp"
      ]
    }
  ]
}
