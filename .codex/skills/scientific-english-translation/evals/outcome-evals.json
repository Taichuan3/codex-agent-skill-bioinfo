{
  "schema_version": 1,
  "skill_name": "scientific-english-translation",
  "purpose": "Evaluate faithful translation, terminology mapping, section function, reproducibility details, and caption preservation.",
  "cases": [
    {
      "id": "scientific-english-translation-fidelity-existing-claim",
      "mode": "light",
      "task": "忠实译成英文：我们提出一种新的学习算法。最重要的是它不用人工标签；其次它共享编码器；第三它联合预测两个目标；第四它采用新的更新规则。",
      "must_include": [
        "new algorithm retained",
        "four conceptual distinctions and priority retained",
        "no demand for evidence solely because new appears"
      ],
      "must_not": [
        "three-item summary",
        "new silently removed"
      ]
    },
    {
      "id": "scientific-english-translation-fidelity-hypothesis",
      "mode": "light",
      "task": "忠实译成英文：结果看起来很矛盾，因此我们怀疑突变破坏了结合。为检验这一假设，我们测量了亲和力。结果确实显示结合减弱，揭示了一种新的调节机制。",
      "must_include": [
        "paradox motivates hypothesis before test",
        "indeed and new mechanism retained"
      ],
      "must_not": [
        "post-hoc hypothesis",
        "default suggest replacing reveal"
      ]
    },
    {
      "id": "scientific-english-translation-fidelity-overclaim",
      "mode": "light",
      "task": "忠实译成英文：我们仅观察了相关性（r=0.30），未做干预。这完全证明X导致Y。",
      "must_include": [
        "original causal wording traceable",
        "conflict flagged separately",
        "optional alternative labelled as suggestion",
        "unaffected text delivered"
      ],
      "must_not": [
        "silently replace claim",
        "unqualified final causal assertion",
        "publication-ready claim"
      ]
    },
    {
      "id": "scientific-english-translation-fidelity-citation-purpose",
      "mode": "light",
      "task": "忠实译成英文，保留两段：早期研究发现文献指数增长[2]。我们的估计为每17年翻倍。\n\n我们过滤样品以减少聚集。另一个模型也预测此趋势。",
      "must_include": [
        "[2] remains bound to early exponential growth",
        "17 years preserved",
        "purpose not measured effect",
        "another model retained",
        "paragraph membership retained"
      ],
      "must_not": [
        "citation moved to doubling estimate",
        "therefore without input support",
        "filtering asserted to have reduced aggregation"
      ]
    },
    {
      "id": "scientific-english-translation-fidelity-structural",
      "mode": "structural",
      "task": "按指定顺序重组并译成英文：A. 模型预测X是创新的信号。B. 生命周期分析支持该判断[4]。C. 研究旨在辨识创新信号。按问题、结论、支持重组，不增加信息。",
      "must_include": [
        "question before conclusion and support",
        "claim/evidence/citation stay linked",
        "signal claim retained"
      ],
      "must_not": [
        "may reflect replacing is a signal",
        "invented causal explanation"
      ]
    },
    {
      "id": "scientific-english-translation-fidelity-terms",
      "mode": "light",
      "task": "忠实译成英文，采用英式拼写：我们分析假性甲状旁腺功能减退症。条形码碰撞率为2%。使用蒙特卡洛树搜索而非rollout；两者不可混用。",
      "must_include": [
        "disease name not hybridised",
        "barcode collision not contamination",
        "2% retained",
        "MCTS distinct from rollout",
        "UK spelling where applicable"
      ],
      "must_not": [
        "guess original paper",
        "delete technical distinctions"
      ]
    },
    {
      "id": "translation-profile-fidelity-01",
      "mode": "faithful English with literal override",
      "task": "将以下中文结果直译成英文，保留顺序和小标题：\n### 队列一\n24个样本中X与Y相关，r=0.42。\n### 队列二\n另18个样本的差异不显著。这是初步观察。",
      "must_include": ["24 and 18 distinct", "r=0.42 unchanged", "association only", "nonsignificant and preliminary preserved", "two headings translated while preserving count order level and paragraph membership"],
      "must_not": ["equivalence", "causality", "force structural rewrite", "invent figure citation"]
    },
    {
      "id": "english-translation-outcome-faithful-01",
      "mode": "faithful Results translation",
      "task": "Translate a Chinese Results paragraph with quantitative observations and bounded wording.",
      "must_include": [
        "directly usable English version",
        "all numbers preserved",
        "observational Results stance",
        "stable terminology",
        "source meaning checked"
      ],
      "must_not": [
        "upgrade association to causation",
        "invent mechanism or novelty",
        "omit a limiting phrase"
      ]
    },
    {
      "id": "english-translation-outcome-terms-01",
      "mode": "terminology-sensitive translation",
      "task": "Translate Chinese text whose key concept is named inconsistently in the source.",
      "must_include": [
        "accurate preferred English term without epistemic downgrading",
        "terminology map",
        "source ambiguity flagged",
        "consistent use in the translation",
        "distinctions retained when real"
      ],
      "must_not": [
        "use synonyms for stylistic variety",
        "invent a biological distinction",
        "hide unresolved ambiguity"
      ]
    },
    {
      "id": "english-translation-outcome-journal-01",
      "mode": "journal-leaning abstract translation",
      "task": "Translate and condense a Chinese abstract for a high-impact-journal-facing English draft.",
      "must_include": [
        "context-to-gap-to-action-to-result flow",
        "bounded implication",
        "only decision-relevant numbers",
        "claim strength preserved",
        "target-journal caveat when rules are unknown"
      ],
      "must_not": [
        "add novelty language",
        "turn the abstract into a data inventory",
        "present generic guidance as journal-specific rules"
      ]
    },
    {
      "id": "english-translation-outcome-methods-01",
      "mode": "Methods translation",
      "task": "Translate Chinese Methods containing versions, parameters, filtering, and sample definitions.",
      "must_include": [
        "precise English methods verbs",
        "versions and parameters preserved",
        "filters and samples preserved",
        "uncertain source text flagged",
        "reproducibility retained"
      ],
      "must_not": [
        "polish away technical details",
        "silently correct values",
        "add unprovided procedures"
      ]
    },
    {
      "id": "translation-direct-request-input-01",
      "mode": "translation request authorizes this input",
      "task": "请翻译以下中文，不另走中文确认：在30份样本中，A与B相关（r=0.36），但该关联仅见于处理组。未检验因果关系。",
      "must_include": ["complete English translation immediately", "30, r=0.36 and treated-group-only scope retained", "causality untested retained"],
      "must_not": ["ask for redundant Chinese approval", "invent P value or control result", "automatically apply Hashimoto style"]
    },
    {
      "id": "translation-approval-only-input-01",
      "mode": "Chinese acceptance is not translation authorization",
      "task": "中文稿确认没有问题，暂时停在这个版本，今天不用翻译。",
      "must_include": ["acknowledge current Chinese stage", "no English manuscript generated"],
      "must_not": ["advance to English translation", "generate an optional English variant anyway"]
    },
    {
      "id": "translation-conflict-input-01",
      "mode": "numerical ambiguity",
      "task": "翻译成英文：共纳入48例患者；分析全部52例患者后发现两个亚组存在表达差异。没有更多说明。",
      "must_include": ["48 versus 52 mismatch identified", "no silent correction of n", "unambiguous content translated", "brief author action to reconcile cohort count"],
      "must_not": ["invent exclusions", "replace both values with a chosen count", "claim translation resolves the underlying scientific issue"]
    },
    {
      "id": "translation-literal-details-input-01",
      "mode": "literal translation preserves source detail",
      "task": "忠实翻译，不压缩：三次实验的效应值分别为0.2、0.3和0.1。合并估计为0.2（95% CI 0.05–0.35）。这是初步结果，尚未完成外部验证。",
      "must_include": ["0.2, 0.3, 0.1 trial values preserved", "pooled 0.2 and 95% CI 0.05–0.35 preserved", "preliminary status and incomplete external validation preserved"],
      "must_not": ["drop details to follow abstract style", "claim external validation completed", "invent number of subjects"]
    },
    {
      "id": "translation-readonly-input-01",
      "mode": "chat-only delivery",
      "task": "请仅在聊天里翻译：我们使用工具Q 2.4.1，以阈值0.03筛选。不要更改稿件文件或项目文档。",
      "must_include": ["English version with Q 2.4.1 and 0.03", "no filesystem changes", "no claim of installed or saved manuscript"],
      "must_not": ["update GUIDE or PLAN", "silently substitute another tool or cutoff"]
    },
    {
      "id": "english-translation-outcome-caption-01",
      "mode": "existing caption translation",
      "task": "Translate a complete Chinese caption into English without changing content.",
      "must_include": [
        "English caption in original panel order",
        "numbers and statistics preserved",
        "symbols and abbreviations preserved",
        "terminology consistent",
        "missing source information not invented"
      ],
      "must_not": [
        "redesign the caption contract",
        "add guessed n or tests",
        "move interpretation beyond the source"
      ]
    }
  ]
}
